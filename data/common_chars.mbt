  "追赘坠缀谆捉拙卓桌琢茁酌啄灼浊兹咨姿滋淄孜紫仔籽滓渍字鬃棕踪宗综纵邹奏揍租足卒祖诅阻钻纂嘴醉罪尊遵昨左佐柞坐座"

///|
/// 返回汉字在常用字序列中的字节偏移（越小越常用），未收录返回 100000。
pub fn common_char_rank(ch : String) -> Int32 {
  match common_chars.find(ch) {
    Some(offset) => offset
    None => 100000
  }
}
