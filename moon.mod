name = "walkzzz/pinyin"

version = "0.6.0"

readme = "README.mbt.md"

repository = "https://github.com/toadium/pinyin.git"

license = "MIT"

keywords = [
  "pinyin",
  "chinese",
  "unicode",
  "tone",
  "cangjie",
  "ngram",
  "input-method",
]

description = "MoonBit 拼音引擎 — 汉字→拼音 + 拼音→汉字 + 拼音分词 + 模糊匹配 + 多音字消歧 + 搜索索引 + 变调规则 + 编辑距离 + 拼音规范化 + 繁简转换 + N-gram 语言模型 + 拼音输入法"

supported_targets = "+wasm+wasm-gc+js+native"
